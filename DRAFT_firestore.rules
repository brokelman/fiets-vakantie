rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTripId(tripId) {
      return tripId is string &&
        tripId.size() >= 14 &&
        tripId.size() <= 19 &&
        tripId.matches('^racefiets-2027(-test)?$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'brokelman@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidHouse(data) {
      return data.keys().hasAll([
        'tripId', 'ownerId', 'title', 'url', 'photoUrl', 'locationName',
        'lat', 'lng', 'totalPrice', 'bedrooms', 'bathrooms',
        'hasBbq', 'hasFireplace', 'hasJacuzzi', 'hasSauna',
        'routeUrl', 'notes', 'addedBy', 'voteScore', 'voteCount',
        'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'tripId', 'ownerId', 'title', 'url', 'photoUrl', 'locationName',
        'lat', 'lng', 'totalPrice', 'bedrooms', 'bathrooms',
        'hasBbq', 'hasFireplace', 'hasJacuzzi', 'hasSauna',
        'routeUrl', 'notes', 'addedBy', 'voteScore', 'voteCount',
        'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidTripId(data.tripId) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
      data.url is string && data.url.size() >= 8 && data.url.size() <= 500 && data.url.matches('^https?://.+') &&
      data.photoUrl is string && data.photoUrl.size() <= 500 &&
      data.locationName is string && data.locationName.size() >= 2 && data.locationName.size() <= 160 &&
      data.lat is number && data.lat >= -90 && data.lat <= 90 &&
      data.lng is number && data.lng >= -180 && data.lng <= 180 &&
      data.totalPrice is number && data.totalPrice > 0 && data.totalPrice <= 50000 &&
      data.bedrooms is int && data.bedrooms >= 1 && data.bedrooms <= 50 &&
      data.bathrooms is int && data.bathrooms >= 1 && data.bathrooms <= 50 &&
      data.hasBbq is bool &&
      data.hasFireplace is bool &&
      data.hasJacuzzi is bool &&
      data.hasSauna is bool &&
      data.routeUrl is string && data.routeUrl.size() <= 500 &&
      data.notes is string && data.notes.size() <= 1000 &&
      data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 60 &&
      data.voteScore is int && data.voteScore >= -1000 && data.voteScore <= 1000 &&
      data.voteCount is int && data.voteCount >= 0 && data.voteCount <= 1000 &&
      data.status is string && data.status.size() >= 6 && data.status.size() <= 8 && (data.status == 'active' || data.status == 'archived') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidHouseVote(data, houseId, voteId) {
      return data.keys().hasAll([
        'houseId', 'userId', 'voterName', 'value', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'houseId', 'userId', 'voterName', 'value', 'createdAt', 'updatedAt'
      ]) &&
      data.houseId is string && data.houseId.size() >= 1 && data.houseId.size() <= 128 && data.houseId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.houseId == houseId &&
      data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.userId == voteId &&
      data.userId == request.auth.uid &&
      data.voterName is string && data.voterName.size() >= 1 && data.voterName.size() <= 60 &&
      data.value is int && data.value >= -1 && data.value <= 5 && data.value != 0 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidHouseComment(data, houseId) {
      return data.keys().hasAll([
        'houseId', 'authorId', 'authorName', 'text', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'houseId', 'authorId', 'authorName', 'text', 'createdAt'
      ]) &&
      data.houseId is string && data.houseId.size() >= 1 && data.houseId.size() <= 128 && data.houseId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.houseId == houseId &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.authorId == request.auth.uid &&
      data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 600 &&
      data.createdAt is timestamp;
    }

    function isValidGeneralIdea(data) {
      return data.keys().hasAll([
        'tripId', 'authorId', 'authorName', 'category', 'text', 'likesCount', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'tripId', 'authorId', 'authorName', 'category', 'text', 'likesCount', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidTripId(data.tripId) &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
      data.category is string && data.category.size() >= 5 && data.category.size() <= 10 &&
      (data.category == 'regio' || data.category == 'route' || data.category == 'logistiek' || data.category == 'overig') &&
      data.text is string && data.text.size() >= 2 && data.text.size() <= 600 &&
      data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000 &&
      data.status is string && data.status.size() >= 4 && data.status.size() <= 8 && (data.status == 'open' || data.status == 'resolved') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidParticipant(data) {
      return data.keys().hasAll([
        'tripId', 'ownerId', 'name', 'isDriver', 'carSeats', 'bikeSpots', 'notes', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'tripId', 'ownerId', 'name', 'isDriver', 'carSeats', 'bikeSpots', 'notes', 'createdAt', 'updatedAt'
      ]) &&
      isValidTripId(data.tripId) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
      data.isDriver is bool &&
      data.carSeats is int && data.carSeats >= 0 && data.carSeats <= 15 &&
      data.bikeSpots is int && data.bikeSpots >= 0 && data.bikeSpots <= 15 &&
      data.notes is string && data.notes.size() <= 300 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /houses/{houseId}
    match /houses/{houseId} {
      allow get: if isValidId(houseId) && isValidTripId(resource.data.tripId);
      allow list: if isValidTripId(resource.data.tripId);

      allow create: if isVerifiedUser() &&
        isValidId(houseId) &&
        isValidHouse(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(houseId) &&
        isValidHouse(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().tripId == existing().tripId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().status == 'active' &&
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'url', 'photoUrl', 'locationName', 'lat', 'lng',
              'totalPrice', 'bedrooms', 'bathrooms', 'hasBbq',
              'hasFireplace', 'hasJacuzzi', 'hasSauna', 'routeUrl',
              'notes', 'addedBy', 'status', 'updatedAt'
            ])
          ) ||
          (
            existing().status == 'active' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['voteScore', 'voteCount', 'updatedAt']) &&
            existsAfter(/databases/$(database)/documents/houses/$(houseId)/votes/$(request.auth.uid))
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(houseId) &&
        (existing().ownerId == request.auth.uid || isAdmin());

      // Subcollection: /houses/{houseId}/votes/{voteId}
      match /votes/{voteId} {
        allow get: if isValidId(houseId) && isValidId(voteId) && resource.data.houseId == houseId;
        allow list: if resource.data.houseId == houseId;

        allow create: if isVerifiedUser() &&
          isValidId(houseId) &&
          isValidId(voteId) &&
          isValidHouseVote(incoming(), houseId, voteId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/houses/$(houseId)).data.status == 'active';

        allow update: if isVerifiedUser() &&
          isValidId(houseId) &&
          isValidId(voteId) &&
          isValidHouseVote(incoming(), houseId, voteId) &&
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().houseId == existing().houseId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['value', 'voterName', 'updatedAt']) &&
          get(/databases/$(database)/documents/houses/$(houseId)).data.status == 'active';

        allow delete: if isVerifiedUser() &&
          isValidId(houseId) &&
          isValidId(voteId) &&
          (existing().userId == request.auth.uid || isAdmin());
      }

      // Subcollection: /houses/{houseId}/comments/{commentId}
      match /comments/{commentId} {
        allow get: if isValidId(houseId) && isValidId(commentId) && resource.data.houseId == houseId;
        allow list: if resource.data.houseId == houseId;

        allow create: if isVerifiedUser() &&
          isValidId(houseId) &&
          isValidId(commentId) &&
          isValidHouseComment(incoming(), houseId) &&
          incoming().createdAt == request.time &&
          get(/databases/$(database)/documents/houses/$(houseId)).data.status == 'active';

        allow update: if isVerifiedUser() &&
          isValidId(houseId) &&
          isValidId(commentId) &&
          isValidHouseComment(incoming(), houseId) &&
          existing().authorId == request.auth.uid &&
          incoming().authorId == existing().authorId &&
          incoming().houseId == existing().houseId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['text']) &&
          get(/databases/$(database)/documents/houses/$(houseId)).data.status == 'active';

        allow delete: if isVerifiedUser() &&
          isValidId(houseId) &&
          isValidId(commentId) &&
          (existing().authorId == request.auth.uid || isAdmin());
      }
    }

    // 5. Collection Rules: /ideas/{ideaId}
    match /ideas/{ideaId} {
      allow get: if isValidId(ideaId) && isValidTripId(resource.data.tripId);
      allow list: if isValidTripId(resource.data.tripId);

      allow create: if isVerifiedUser() &&
        isValidId(ideaId) &&
        isValidGeneralIdea(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(ideaId) &&
        isValidGeneralIdea(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().tripId == existing().tripId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().status == 'open' &&
            existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'category', 'status', 'updatedAt'])
          ) ||
          (
            existing().status == 'open' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
            incoming().likesCount == existing().likesCount + 1
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(ideaId) &&
        (existing().authorId == request.auth.uid || isAdmin());
    }

    // 6. Collection Rules: /participants/{participantId}
    match /participants/{participantId} {
      allow get: if isValidId(participantId) && isValidTripId(resource.data.tripId);
      allow list: if isValidTripId(resource.data.tripId);

      allow create: if isVerifiedUser() &&
        isValidId(participantId) &&
        isValidParticipant(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(participantId) &&
        isValidParticipant(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().tripId == existing().tripId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'isDriver', 'carSeats', 'bikeSpots', 'notes', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(participantId) &&
        (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
